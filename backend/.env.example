# Copie en backend/.env (ignoré par git). Les clés API du pipeline restent dans bet_agent/envi.local.

# Jeton exigé dans l'en-tête X-API-Key sur TOUTES les routes (l'API est entièrement privée).
# Sans lui, l'API refuse tout.
# Génère-en un : python -c "import secrets; print(secrets.token_urlsafe(32))"
API_TOKEN=

# Vide = SQLite local (backend/data/bet_agent.db).
# Supabase : Project Settings → Database → Connection string (mode "Session pooler"),
# en remplaçant "postgresql://" par "postgresql+psycopg://" :
# DATABASE_URL=postgresql+psycopg://postgres.fpwsitpdkruoknwmgjzr:MOT_DE_PASSE@aws-0-eu-central-1.pooler.supabase.com:5432/postgres
DATABASE_URL=

# true = réactive /docs, /redoc et /openapi.json (désactivés par défaut)
ACTIVER_DOCS=

# Schéma PostgreSQL des tables (défaut : analyse_football, dans le projet Supabase nombre-mystere)
DB_SCHEMA=
